generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------
// OJO TOURS DATABASE SCHEMA
// --------------------------------------

model Tour {
  id          String   @id @default(cuid())
  title       String
  location    String
  duration    String
  price       String
  rating      Float    @default(5.0)
  category    String
  image       String
  description String   @db.Text
  groupSize   String?
  difficulty  String?
  itinerary   Json?    // Array of {day, title, desc}
  included    String[] @default([])
  excluded    String[] @default([])
  gallery     String[] @default([])
  faqs        Json?    // Array of {q, a}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lodge {
  id          String   @id @default(cuid())
  name        String
  location    String
  description String   @db.Text
  price       String
  image       String
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Journal {
  id        String   @id @default(cuid())
  title     String
  slug      String?  @unique
  category  String
  author    String
  readTime  String
  image     String
  excerpt   String   @db.Text
  content   String?  @db.Text
  gallery   String[]
  status    String   @default("draft")
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id                String   @id @default(cuid())
  itemId            String   // Foreign key to Tour or Lodge
  itemType          String   // "Tour" or "Lodge"
  customerName      String
  customerEmail     String
  customerPhone     String?
  date              DateTime
  guests            Int
  totalPrice        Float
  status            String   @default("Pending") // Pending, Confirmed, Declined, Cancelled, Waitlisted
  paymentType       String   @default("Full") // Full, Deposit
  depositAmount     Float?
  depositPaid       Boolean  @default(false)
  remainingAmount   Float?
  currency          String   @default("USD")
  specialRequests   String?  @db.Text
  cancellationReason String?  @db.Text
  cancelledAt       DateTime?
  cancelledBy       String?  // User ID or "System"
  confirmationSent  Boolean  @default(false)
  confirmedAt       DateTime?
  userId            String?  // Link to user (nullable for backward compatibility)
  user              User?    @relation("UserBookings", fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  payments          Payment[]
  modifications      BookingModification[]
  
  @@index([userId])
  @@index([itemId])
  @@index([status])
  @@index([date])
}

// --- AVAILABILITY TRACKING MODELS ---
model TourAvailability {
  id          String   @id @default(cuid())
  tourId      String
  date        DateTime
  bookedSlots Int      @default(0)
  maxSlots    Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tourId, date])
  @@index([tourId])
  @@index([date])
}

model LodgeAvailability {
  id          String   @id @default(cuid())
  lodgeId     String
  date        DateTime
  bookedSlots Int      @default(0)
  maxSlots    Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([lodgeId, date])
  @@index([lodgeId])
  @@index([date])
}

// --- PRICING MODELS ---
model SeasonalPricing {
  id          String   @id @default(cuid())
  itemId      String
  itemType    String   // "Tour" or "Lodge"
  startDate   DateTime
  endDate     DateTime
  multiplier  Float    @default(1.0) // e.g., 1.2 for 20% increase
  reason      String?  // e.g., "Peak season", "Holiday"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([itemId])
  @@index([startDate, endDate])
}

model GroupPricingRule {
  id              String   @id @default(cuid())
  itemId          String
  itemType        String   // "Tour" or "Lodge"
  minGuests       Int
  maxGuests       Int?
  discountPercent Float    // e.g., 10 for 10% discount
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([itemId])
}

// --- BOOKING MODIFICATION MODEL ---
model BookingModification {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  modifiedBy    String   // User ID who made the modification
  modificationType String // "date", "guests", "status"
  oldValue      Json?
  newValue      Json?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())
  
  @@index([bookingId])
  @@index([createdAt])
}

// --- WAITLIST MODEL ---
model Waitlist {
  id          String   @id @default(cuid())
  itemId      String
  itemType    String   // "Tour" or "Lodge"
  userId      String?
  user        User?    @relation("UserWaitlist", fields: [userId], references: [id])
  customerName String
  customerEmail String
  customerPhone String?
  preferredDate DateTime
  guests      Int
  status      String   @default("Pending") // Pending, Contacted, Booked, Expired
  contactedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([itemId])
  @@index([userId])
  @@index([status])
  @@index([preferredDate])
}

// --- PAYMENT PLAN MODEL ---
model PaymentPlan {
  id            String   @id @default(cuid())
  bookingId     String
  totalAmount   Float
  depositAmount Float
  depositPaid   Boolean  @default(false)
  depositPaidAt DateTime?
  remainingAmount Float
  installments  Json     // Array of {amount, dueDate, paid, paidAt}
  currency      String   @default("USD")
  status        String   @default("Active") // Active, Completed, Cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([bookingId])
  @@index([status])
}

// --- WISHLIST MODEL ---
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserWishlist", fields: [userId], references: [id])
  itemId    String
  itemType  String   // "Tour", "Lodge", "Journal"
  createdAt DateTime @default(now())
  
  @@unique([userId, itemId, itemType])
  @@index([userId])
}

// --- GALLERY MODEL ---
model Gallery {
  id        String   @id @default(cuid())
  title     String // e.g., "Silverback Gorilla"
  category  String // e.g., "Wildlife", "Nature"
  image     String // The ImgBB or Unsplash URL
  className String // This keeps your masonry layout looking cool (e.g., "md:col-span-2 md:row-span-2")
  createdAt DateTime @default(now())
}

// --- REVIEW MODEL ---
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserReviews", fields: [userId], references: [id])
  itemId    String
  itemType  String   // "Tour", "Lodge"
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, itemId, itemType])
  @@index([userId])
}

// --- TEAM MODEL ---
model Team {
  id        String   @id @default(cuid())
  name      String
  role      String
  image     String
  bio       String   @db.Text
  createdAt DateTime @default(now())
}

// --- NOTIFICATION MODEL ---
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  title     String
  message   String   @db.Text
  type      String   // "booking", "payment", "trip", "system"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
}

// --- AUTHENTICATION & RBAC MODELS ---

// User Model - Links Supabase Auth to Database
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  authProvider  String?   // Initial sign-in method: email, google, github, etc.
  fullName      String?
  avatar        String?
  supabaseId    String    @unique  // Link to Supabase auth user ID
  role          Role      @relation(fields: [roleId], references: [id])
  roleId        String
  isActive      Boolean   @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  sessions      Session[]
  authEvents    AuthEvent[]
  
  // Tourist-specific fields
  phone         String?
  emergencyContact String?
  emergencyPhone String?
  preferences   Json?     // Store user preferences
  
  // Tourist dashboard relationships
  bookings      Booking[]       @relation("UserBookings")
  wishlist      Wishlist[]      @relation("UserWishlist")
  reviews       Review[]        @relation("UserReviews")
  notifications  Notification[]  @relation("UserNotifications")
  payments      Payment[]       @relation("UserPayments")
  contacts      Contact[]       @relation("UserContacts")
  waitlistEntries Waitlist[]    @relation("UserWaitlist")
  
  @@index([supabaseId])
  @@index([email])
  @@index([roleId])
}

// Role Model - Defines user roles
model Role {
  id          String        @id @default(cuid())
  name        String        @unique  // SUPER_ADMIN, ADMIN, STAFF, TOURIST
  description String?
  permissions Permission[]   @relation("RolePermissions")
  users       User[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([name])
}

// Permission Model - Future-ready for granular permissions
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "tours:create", "bookings:approve"
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())
  
  @@index([name])
}

// Session Model - Optional for audit trail and session management
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// Security-relevant application events. Secrets, tokens, IP addresses, and
// authenticator factor secrets must never be stored here.
model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  provider  String?
  success   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// --- PAYMENT MODEL ---
model Payment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserPayments", fields: [userId], references: [id])
  bookingId     String?
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  amount        Float
  currency      String   @default("USD")
  status        String   @default("Pending") // Pending, Completed, Failed, Refunded
  paymentMethod String?
  paymentType   String   @default("Full") // Full, Deposit, Installment
  transactionId String?
  refundedAt    DateTime?
  refundReason  String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([bookingId])
  @@index([status])
}

// --- SETTINGS MODEL ---
model Settings {
  id              String   @id @default(cuid())
  siteName        String   @default("OJO Tours")
  siteDescription String?  @db.Text
  contactEmail    String?
  contactPhone    String?
  contactAddress  String?  @db.Text
  socialLinks     Json?    // Store social media links as JSON
  seoKeywords     String?  @db.Text
  maintenanceMode Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- CONTACT MODEL ---
model Contact {
  id        String   @id @default(cuid())
  userId    String?  // Link to user if authenticated
  user      User?    @relation("UserContacts", fields: [userId], references: [id])
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("New") // New, In Progress, Resolved
  ipAddress String?  // Optional IP tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// --- NEWSLETTER SUBSCRIBER MODEL ---
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  fullName       String?
  status         String    @default("Active") // Active, Unsubscribed
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([email])
  @@index([status])
  @@index([subscribedAt])
}
